# Where the app reaches the API. The app talks to the API directly with a Bearer
# token; it does not go through the web BFF.
#   iOS simulator:    http://localhost:4000
#   Android emulator: http://10.0.2.2:4000
#   Physical device:  http://<your computer's LAN IP>:4000
#                     (also set S3_PUBLIC_ENDPOINT in apps/api/.env to that IP, see README)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Used to build shareable links to public files (opens the web app).
EXPO_PUBLIC_WEB_URL=http://localhost:3000
