# Used by docker compose --profile app. Service hostnames resolve on the compose network.
NODE_ENV=production
LOG_LEVEL=info
PORT=4000
DATABASE_URL=postgres://media:media@postgres:5432/media
S3_ENDPOINT=http://storage:9000
# Browsers run on the host, so signed URLs must point at the published port.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY_ID=media-dev
S3_SECRET_ACCESS_KEY=media-dev-secret
S3_FORCE_PATH_STYLE=true
STORAGE_CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=true
