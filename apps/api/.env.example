# Copy to .env — values below match docker-compose.yml for local development.
NODE_ENV=development
LOG_LEVEL=debug
PORT=4000

DATABASE_URL=postgres://media:media@localhost:5433/media

# Internal endpoint (API/worker -> storage) and public endpoint (browser -> storage).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY_ID=media-dev
S3_SECRET_ACCESS_KEY=media-dev-secret
S3_FORCE_PATH_STYLE=true
STORAGE_CORS_ORIGINS=http://localhost:3000

UPLOAD_PART_SIZE_BYTES=16777216
UPLOAD_URL_TTL_SECONDS=3600
DOWNLOAD_URL_TTL_SECONDS=900
STALE_UPLOAD_MAX_AGE_SECONDS=86400

SESSION_TTL_SECONDS=2592000
# The API is only reachable through the web BFF, which forwards the client IP.
TRUST_PROXY=true

WORKER_CONCURRENCY=2
PROCESSING_RETRY_LIMIT=3
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
