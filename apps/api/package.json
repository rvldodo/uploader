{
  "name": "@media-upload/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,worker -c blue,magenta \"pnpm dev:server\" \"pnpm dev:worker\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/main/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/main/worker.ts",
    "build": "tsup",
    "start:server": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/main/migrate.ts",
    "storage:init": "tsx --env-file-if-exists=.env src/main/init-storage.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "media:transfer-legacy": "tsx --env-file-if-exists=.env src/main/transfer-legacy-media.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@media-upload/contracts": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "pg-boss": "^12.36.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  }
}
